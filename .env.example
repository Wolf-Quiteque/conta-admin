# Ligação à base de dados Neon Postgres — usar a connection string "unpooled"
# (Vercel > Storage > Neon > .env.local > DATABASE_URL_UNPOOLED).
# Deve ser IGUAL à usada no projeto conta-clientes.
#
# Em produção, a integração Vercel-Neon injeta esta variável com um prefixo
# específico do projeto (ver Settings > Environment Variables no dashboard —
# atualmente algo como `nawabus_cliene_conta_DATABASE_URL_UNPOOLED`). O código
# tenta primeiro a versão com prefixo e depois recua para o nome simples
# (lib/db/connection-string.ts), por isso não precisa de igualar os nomes,
# apenas garantir que uma das duas variáveis está definida em cada ambiente.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# Token de leitura/escrita do Vercel Blob (Vercel > Storage > Blob > .env.local)
# Só é necessário aqui se o admin também gerir uploads no futuro; mantenha
# igual ao do conta-clientes por consistência.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Segredo usado para assinar o cookie de sessão. Gerar com: openssl rand -base64 32
# Pode ser diferente do usado em conta-clientes.
SESSION_SECRET="substituir-por-um-valor-aleatorio"
